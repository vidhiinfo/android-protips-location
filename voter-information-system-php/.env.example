# =====================================================================
# Voter Information System - settings. Copy this file to ".env" and edit.
# Never upload .env anywhere public; it holds passwords.
# =====================================================================

APP_NAME="Voter Information System"
APP_ENV=production
# Leave empty: a key is created automatically on the first visit
APP_KEY=
# true only while setting up (shows error details); false when live
APP_DEBUG=false
# Your site address. Starting with https:// makes every link https.
APP_URL=https://voters.example.com
APP_TIMEZONE=Asia/Kolkata

LOG_CHANNEL=daily
LOG_LEVEL=warning

# ---------------------------------------------------------------- MySQL
# cPanel adds your account name in front: e.g. myacct_voter_db / myacct_voter_app
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=voter_db
DB_USERNAME=voter_app
DB_PASSWORD=change_me

# Works on any shared host (no Redis / queue worker needed)
SESSION_DRIVER=file
# minutes without activity before logging out (field workers on phones: 480 = 8 hours)
SESSION_LIFETIME=480
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# ---------------------------------------------------------------- first login
# Created once, on first start, when no user exists. Change the password after login.
ADMIN_USER=admin
ADMIN_PASSWORD=Change@Me123

# ---------------------------------------------------------------- two-step login (OTP)
# none = each user may switch it on (Account > Two-step login) | admins = required for users who manage users | all = everyone
# Codes from an authenticator app (free) or by SMS / WhatsApp when a real provider is set up below.
OTP_REQUIRED=none
# OTP_TRUST_DAYS=30

# ---------------------------------------------------------------- your own users table (optional)
# app = users managed in this application (Admin > Users)
# external = log in with your existing users / roles tables
USER_SOURCE=app
# USERS_QUERY="select username, password, enabled, assembly_no, full_name from users where username = ?"
# USERS_ROLE_MAP="SUPERVISOR=ADMIN,DATA_ENTRY=OPERATOR,FIELD_STAFF=VIEWER"
# ROLES_QUERY="select r.role_name from user_roles ur join users u on u.id = ur.user_id join roles r on r.id = ur.role_id where u.username = ?"
# USERS_PASSWORD_ENCODING=bcrypt
# USERS_DB_CONNECTION=

# false hides Ward No on every screen, filter, export and user access area (rolls without wards, e.g. Uttar Pradesh)
# SHOW_WARD_NO=false

# Daily database backup (Admin > Backups): files in storage/app/backups, the newest BACKUP_KEEP kept.
# Best with a daily cron job: php /home/USER/public_html/vis/artisan vis:backup ; without one it runs once a day after a page visit.
# BACKUP_KEEP=14
# BACKUP_ON_VISIT=true

# State summary across division installations (docs/STATE-SUMMARY.md)
# Division site: STATE_FEED_TOKEN=long-random-secret   STATE_FEED_NAME="Lucknow division"
# State site:    STATE_SOURCES="Lucknow division|https://lko.example.in|token1;Ayodhya division|https://ayd.example.in|token2"

# Largest voter list for PDF / Print (about 4.5 MB of PHP memory per 1,000 rows). Excel has no limit.
PDF_MAX_ROWS=5000

# Printed at the bottom of every voter slip (Voters > Slips). Keep it neutral: no party name or symbol.
# SLIP_NOTE="Poll: 7:00 AM to 6:00 PM. Carry your EPIC card or another approved photo ID."

# ---------------------------------------------------------------- mobile app (optional)
# Store links shown on the /mobile-app page once the app is published. An Android APK placed at public/downloads/voter-system.apk is offered automatically.
# APP_PLAY_URL=https://play.google.com/store/apps/details?id=in.electionsoft.vis
# APP_STORE_URL=https://apps.apple.com/app/id0000000000

# ---------------------------------------------------------------- branding (optional)
# BRAND_ORGANISATION="Jan Vikas Party - Jaipur"
# BRAND_BANNER=/images/login-banner.svg
# BRAND_LOGO=
# Product name on the login page, menu bar, page titles and the phone app (empty = Voter Information System)
# BRAND_APP_NAME="Booth Management Solution (Uttar Pradesh)"
# BRAND_APP_NAME_LOCAL="बूथ प्रबंधन समाधान (उत्तर प्रदेश)"
# BRAND_SHORT_NAME="Booth UP"
# Company that owns the solution: "Powered by ..." on the login page and a copyright line at the bottom of every page
# BRAND_OWNER="Vidhi Info Solutions"

# ---------------------------------------------------------------- SMS / WhatsApp
# log = dry run (recorded, not sent). SMS: log | twilio | http   WhatsApp: log | twilio | meta
SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
MSG_COUNTRY_CODE=+91
MSG_RATE=5
MSG_SEND_FROM=09:00
MSG_SEND_UNTIL=21:00
MSG_TIME_ZONE=Asia/Kolkata
MSG_SILENCE_PERIOD=true

# Twilio (SMS and WhatsApp)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=

# Meta WhatsApp Cloud API
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# Any Indian SMS gateway with an HTTP API (MSG91, Textlocal, Fast2SMS ...)
# Placeholders: {mobile} {e164} {message} {templateId} {senderId} {entityId}
# SMS_HTTP_METHOD=GET
# SMS_HTTP_URL="https://gateway.example.com/send?apikey=XXXX&to={mobile}&sender={senderId}&msg={message}&dlt_template={templateId}"
# SMS_HTTP_BODY=
# SMS_HTTP_CONTENT_TYPE=application/x-www-form-urlencoded
# SMS_HTTP_AUTH_HEADER=
# SMS_HTTP_SUCCESS=
# SMS_SENDER_ID=
# SMS_DLT_ENTITY_ID=
