{
  "appId": "in.electionsoft.vis",
  "appName": "Voter System",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "electionsoft.in",
      "www.electionsoft.in"
    ],
    "errorPath": "offline.html",
    "hostname": "localhost"
  },
  "android": {
    "allowMixedContent": false,
    "adjustMarginsForEdgeToEdge": "auto"
  },
  "ios": {
    "contentInset": "automatic",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0d6efd",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0d6efd",
      "overlaysWebView": false
    }
  }
}
